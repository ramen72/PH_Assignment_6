```ejs
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset Successful</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#f3f6fb;
  font-family:Arial, Helvetica, sans-serif;
">

  <!-- Main Wrapper -->
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="
      background-color:#f3f6fb;
      padding:40px 15px;
    "
  >
    <tr>
      <td align="center">

        <!-- Email Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width:600px;
            background-color:#ffffff;
            border-radius:18px;
            overflow:hidden;
            box-shadow:0 10px 35px rgba(31,41,55,0.10);
          "
        >

          <!-- ================= HEADER ================= -->
          <tr>
            <td
              align="center"
              style="
                background-color:#16a34a;
                padding:38px 25px;
              "
            >

              <!-- Success Icon -->
              <table
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="margin-bottom:18px;"
              >
                <tr>
                  <td
                    align="center"
                    style="
                      width:56px;
                      height:56px;
                      background-color:#ffffff;
                      border-radius:50%;
                      font-size:28px;
                      line-height:56px;
                    "
                  >
                    ✓
                  </td>
                </tr>
              </table>

              <h1
                style="
                  margin:0;
                  color:#ffffff;
                  font-size:26px;
                  font-weight:700;
                  line-height:1.3;
                "
              >
                Password Reset Successful
              </h1>

              <p
                style="
                  margin:8px 0 0;
                  color:#dcfce7;
                  font-size:14px;
                  line-height:1.5;
                "
              >
                Your account password has been updated
              </p>

            </td>
          </tr>


          <!-- ================= CONTENT ================= -->
          <tr>
            <td style="padding:40px 40px 35px;">

              <!-- Greeting -->
              <p
                style="
                  margin:0 0 8px;
                  color:#111827;
                  font-size:20px;
                  font-weight:600;
                "
              >
                Hello <%= userName %>,
              </p>


              <!-- Main Message -->
              <p
                style="
                  margin:0 0 28px;
                  color:#6b7280;
                  font-size:15px;
                  line-height:1.7;
                "
              >
                Your password has been successfully reset.
                You can now sign in to your account using your new password.
              </p>


              <!-- ================= SUCCESS CARD ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background-color:#f0fdf4;
                  border:1px solid #bbf7d0;
                  border-radius:14px;
                "
              >
                <tr>
                  <td align="center" style="padding:28px 20px;">

                    <!-- Check Icon -->
                    <table
                      cellpadding="0"
                      cellspacing="0"
                      border="0"
                      style="margin-bottom:15px;"
                    >
                      <tr>
                        <td
                          align="center"
                          style="
                            width:48px;
                            height:48px;
                            background-color:#dcfce7;
                            border-radius:50%;
                            color:#16a34a;
                            font-size:24px;
                            font-weight:bold;
                            line-height:48px;
                          "
                        >
                          ✓
                        </td>
                      </tr>
                    </table>

                    <p
                      style="
                        margin:0 0 7px;
                        color:#166534;
                        font-size:17px;
                        font-weight:700;
                      "
                    >
                      Password Updated
                    </p>

                    <p
                      style="
                        margin:0;
                        color:#15803d;
                        font-size:13px;
                        line-height:1.6;
                      "
                    >
                      Your new password is now active and ready to use.
                    </p>

                  </td>
                </tr>
              </table>


              <!-- ================= LOGIN BUTTON ================= -->
              <table
                cellpadding="0"
                cellspacing="0"
                border="0"
                align="center"
                style="margin:28px auto 0;"
              >
                <tr>
                  <td
                    align="center"
                    style="
                      background-color:#4f46e5;
                      border-radius:9px;
                    "
                  >
                    <a
                      href="<%= loginUrl %>"
                      style="
                        display:inline-block;
                        padding:13px 28px;
                        color:#ffffff;
                        text-decoration:none;
                        font-size:14px;
                        font-weight:600;
                        border-radius:9px;
                      "
                    >
                      Sign In to Your Account
                    </a>
                  </td>
                </tr>
              </table>


              <!-- ================= SECURITY NOTICE ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  margin-top:28px;
                  background-color:#fff7ed;
                  border-radius:10px;
                "
              >
                <tr>

                  <td
                    valign="top"
                    style="
                      padding:16px;
                      font-size:20px;
                    "
                  >
                    🛡️
                  </td>

                  <td
                    style="
                      padding:16px 16px 16px 0;
                    "
                  >

                    <p
                      style="
                        margin:0 0 5px;
                        color:#9a3412;
                        font-size:13px;
                        font-weight:700;
                      "
                    >
                      Wasn't you?
                    </p>

                    <p
                      style="
                        margin:0;
                        color:#c2410c;
                        font-size:12px;
                        line-height:1.6;
                      "
                    >
                      If you did not reset your password, please contact
                      our support team immediately and secure your account.
                    </p>

                  </td>

                </tr>
              </table>


              <!-- Reset Time -->
              <% if (resetTime) { %>
                <p
                  style="
                    margin:25px 0 0;
                    color:#9ca3af;
                    font-size:12px;
                    text-align:center;
                  "
                >
                  Password reset completed on <strong><%= resetTime %></strong>
                </p>
              <% } %>


              <!-- Closing -->
              <p
                style="
                  margin:25px 0 0;
                  color:#9ca3af;
                  font-size:12px;
                  line-height:1.6;
                  text-align:center;
                "
              >
                You can safely ignore this email if you requested this
                password change.
              </p>

            </td>
          </tr>


          <!-- ================= FOOTER ================= -->
          <tr>
            <td
              align="center"
              style="
                background-color:#f8fafc;
                border-top:1px solid #eef0f4;
                padding:25px 20px;
              "
            >

              <p
                style="
                  margin:0 0 8px;
                  color:#374151;
                  font-size:14px;
                  font-weight:700;
                "
              >
                <%= appName %>
              </p>

              <p
                style="
                  margin:0 0 8px;
                  color:#9ca3af;
                  font-size:11px;
                "
              >
                Secure. Simple. Reliable.
              </p>

              <p
                style="
                  margin:0;
                  color:#b0b5bd;
                  font-size:11px;
                "
              >
                © <%= currentYear %> <%= appName %>. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>
```
