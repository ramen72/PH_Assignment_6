<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify Your OTP</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#f3f6fb;
  font-family:Arial, Helvetica, sans-serif;
">

  <!-- Main Wrapper -->
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="background-color:#f3f6fb; padding:40px 15px;"
  >
    <tr>
      <td align="center">

        <!-- Email Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width:600px;
            background-color:#ffffff;
            border-radius:18px;
            overflow:hidden;
            box-shadow:0 10px 35px rgba(31,41,55,0.10);
          "
        >

          <!-- ================= HEADER ================= -->
          <tr>
            <td
              align="center"
              style="
                background-color:#4f46e5;
                padding:38px 25px;
              "
            >

              <!-- Logo -->
              <table
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="margin-bottom:18px;"
              >
                <tr>
                  <td
                    align="center"
                    style="
                      width:52px;
                      height:52px;
                      background-color:#ffffff;
                      border-radius:14px;
                      font-size:25px;
                      line-height:52px;
                    "
                  >
                    🔐
                  </td>
                </tr>
              </table>

              <h1
                style="
                  margin:0;
                  color:#ffffff;
                  font-size:26px;
                  font-weight:700;
                  line-height:1.3;
                "
              >
                Password Reset
              </h1>

              <p
                style="
                  margin:8px 0 0;
                  color:#dddafe;
                  font-size:14px;
                  line-height:1.5;
                "
              >
                Secure verification for your account
              </p>

            </td>
          </tr>

          <!-- ================= CONTENT ================= -->
          <tr>
            <td style="padding:40px 40px 35px;">

              <!-- Greeting -->
              <p
                style="
                  margin:0 0 8px;
                  color:#111827;
                  font-size:20px;
                  font-weight:600;
                "
              >
                Hello, <%= name %>,
              </p>

              <p
                style="
                  margin:0 0 28px;
                  color:#6b7280;
                  font-size:15px;
                  line-height:1.7;
                "
              >
                We received a request to reset your password.
                Use the verification code below to continue.
              </p>


              <!-- ================= OTP CARD ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background-color:#f8f7ff;
                  border:1px solid #e5e2ff;
                  border-radius:16px;
                "
              >
                <tr>
                  <td align="center" style="padding:28px 20px;">
                    <p
                      style="
                        margin:0 0 18px;
                        color:#6b7280;
                        font-size:13px;
                        font-weight:600;
                        text-transform:uppercase;
                        letter-spacing:1px;
                      "
                    >
                      Your Verification Code
                    </p>

                    <!-- OTP Digits -->
                    <table
                      cellpadding="0"
                      cellspacing="0"
                      border="0"
                      align="center"
                    >
                      <tr>
                         <% OTP.forEach((letter) => { %>
                        <td style="padding:0 4px;">
                            <div style="
                            width:42px;
                            height:52px;
                            background-color:#ffffff;
                            border:1px solid #ddd6fe;
                            border-radius:10px;
                            color:#4f46e5;
                            font-size:25px;
                            font-weight:700;
                            line-height:52px;
                            text-align:center;
                            ">
                            <%= letter %>
                            </div>
                        </td>
                        <% }) %>
                      </tr>
                    </table>
                    <p
                      style="
                        margin:14px 0 0;
                        color:#9ca3af;
                        font-size:12px;
                      "
                    >
                      Use this code to verify your identity
                    </p>

                  </td>
                </tr>
              </table>


              <!-- ================= EXPIRY ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="margin-top:22px;"
              >
                <tr>

                  <td
                    width="45"
                    valign="top"
                    style="
                      background-color:#fff7ed;
                      border-radius:10px 0 0 10px;
                      padding:14px 0 14px 15px;
                      font-size:20px;
                    "
                  >
                    ⏱️
                  </td>

                  <td
                    style="
                      background-color:#fff7ed;
                      border-radius:0 10px 10px 0;
                      padding:14px 15px 14px 8px;
                    "
                  >

                    <p
                      style="
                        margin:0 0 3px;
                        color:#9a3412;
                        font-size:13px;
                        font-weight:700;
                      "
                    >
                      Code expires soon
                    </p>

                    <p
                      style="
                        margin:0;
                        color:#c2410c;
                        font-size:12px;
                        line-height:1.5;
                      "
                    >
                      This OTP is valid for
                      <strong><%= expirationTime %></strong> min.
                    </p>

                  </td>

                </tr>
              </table>


              <!-- ================= SECURITY ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  margin-top:25px;
                  background-color:#f0fdf4;
                  border-radius:10px;
                "
              >
                <tr>

                  <td
                    valign="top"
                    style="
                      padding:16px;
                      font-size:20px;
                    "
                  >
                    🛡️
                  </td>

                  <td
                    style="
                      padding:16px 16px 16px 0;
                    "
                  >

                    <p
                      style="
                        margin:0 0 4px;
                        color:#166534;
                        font-size:13px;
                        font-weight:700;
                      "
                    >
                      Keep your account secure
                    </p>

                    <p
                      style="
                        margin:0;
                        color:#15803d;
                        font-size:12px;
                        line-height:1.6;
                      "
                    >
                      Never share this verification code with anyone.
                      Our team will never ask you for your OTP.
                    </p>

                  </td>

                </tr>
              </table>


              <!-- Didn't request -->
              <p
                style="
                  margin:28px 0 0;
                  color:#9ca3af;
                  font-size:12px;
                  line-height:1.6;
                  text-align:center;
                "
              >
                If you didn't request a password reset,
                you can safely ignore this email.
              </p>

            </td>
          </tr>


          <!-- ================= FOOTER ================= -->
          <tr>
            <td
              align="center"
              style="
                background-color:#f8fafc;
                border-top:1px solid #eef0f4;
                padding:25px 20px;
              "
            >

              <p
                style="
                  margin:0 0 8px;
                  color:#374151;
                  font-size:14px;
                  font-weight:700;
                "
              >
                RB Health Care
              </p>

              <p
                style="
                  margin:0 0 8px;
                  color:#9ca3af;
                  font-size:11px;
                "
              >
                Secure. Simple. Reliable.
              </p>

              <p
                style="
                  margin:0;
                  color:#b0b5bd;
                  font-size:11px;
                "
              >
                © <%= currentYear %> RB Health Care. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
```

